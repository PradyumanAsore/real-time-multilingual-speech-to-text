# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Speech to Text"
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=speech_user
POSTGRES_PASSWORD=speech_password
POSTGRES_DB=speech_db

# ── Whisper Model ─────────────────────────────────────────────────────────────
# Options: tiny, base, small, medium, large-v2, large-v3
# medium gives good Hindi-English quality; large-v3 is best but slower.
WHISPER_MODEL_SIZE=medium

# Device: cpu or cuda (use cuda if you have an NVIDIA GPU with CUDA)
WHISPER_DEVICE=cpu

# Compute type: int8 (fastest on CPU), float16 (GPU), float32 (highest quality)
WHISPER_COMPUTE_TYPE=int8

# Language: leave empty for auto-detection (recommended for Hinglish)
WHISPER_LANGUAGE=

# VAD (Silero Voice Activity Detection) – recommended to keep true
WHISPER_VAD_FILTER=true
WHISPER_VAD_THRESHOLD=0.5

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
